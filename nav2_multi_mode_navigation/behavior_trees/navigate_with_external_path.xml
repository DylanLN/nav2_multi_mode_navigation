<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="external_path_mission">
      <GetPathFromTopic
        mission_id="{mission_id}"
        topic="/mission_path"
        timeout_ms="5000"
        max_age_ms="3000"
        path="{external_path}"/>
      <FollowPath path="{external_path}" controller_id="FollowPath" goal_checker_id="general_goal_checker"/>
    </Sequence>
  </BehaviorTree>
</root>
